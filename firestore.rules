rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role == 'admin'
        && request.auth.token.get('mfaVerified', false) == true;
    }

    function isFacility(facilityId) {
      return signedIn()
        && request.auth.token.role == 'facility'
        && request.auth.token.get('registrationOnly', false) != true
        && request.auth.uid == facilityId
        && get(/databases/$(database)/documents/facilities/$(facilityId)).data.status != 'locked';
    }

    function isTrialRegistrationOnly(facilityId) {
      return signedIn()
        && request.auth.token.role == 'facility'
        && request.auth.token.get('registrationOnly', false) == true
        && request.auth.uid == facilityId;
    }

    match /facilities/{facilityId} {
      allow read: if isAdmin() || isFacility(facilityId) || isTrialRegistrationOnly(facilityId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'subscriptionStatus', 'usagePaused', 'usagePausedAt',
          'usageResumedAt', 'usageResumeRequestedAt', 'trialEndsAt',
          'retentionDeletionStartedAt', 'paymentGraceUntil', 'lockReason'
        ]);

      match /users/{userName} {
        allow read: if isAdmin() || isFacility(facilityId);
        allow create: if isAdmin() || (
          isFacility(facilityId)
          && request.resource.data.get('lineUserIds', null) == null
          && request.resource.data.get('lineLinkedAt', null) == null
        );
        allow update: if isAdmin() || (
          isFacility(facilityId)
          && request.resource.data.get('lineUserIds', null) == resource.data.get('lineUserIds', null)
          && request.resource.data.get('lineLinkedAt', null) == resource.data.get('lineLinkedAt', null)
          && request.resource.data.get('legacyStorageOwnerFacilityId', null) == resource.data.get('legacyStorageOwnerFacilityId', null)
        );
        allow delete: if isAdmin() || isFacility(facilityId);
      }

      match /daily_records/{recordId} {
        allow read, write: if isAdmin() || isFacility(facilityId);
      }

      // ご家族からのLINEメッセージ：読めるのはその施設だけ（えこすまいるの管理者は件数だけを施設情報で見る）。
      // 保存・確認済み・お返事はサーバー（respondFamilyMessage）だけが書く
      match /familyMessages/{messageId} {
        allow read: if isFacility(facilityId);
        allow write: if false;
      }

      match /invoiceHistory/{invoiceId} {
        allow read, write: if isAdmin();
      }
    }

    match /facilityCredentials/{facilityId} {
      allow read, write: if isAdmin();
    }

    match /adminLoginChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /adminLoginRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /facilityPasswordResetChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /facilityPasswordResetRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /facilityCancellations/{facilityId} {
      allow read: if isAdmin() || isFacility(facilityId);
      allow write: if isAdmin();
    }

    match /facilityLineSettings/{facilityId} {
      allow read, write: if isAdmin();
    }

    match /linePairingCodes/{codeHash} {
      allow read, write: if isAdmin();
    }

    match /lineRecordLinks/{tokenHash} {
      allow read, write: if isAdmin();
    }

    match /invoiceEmailLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 定期処理の結果（サーバーだけが書き込み、管理者が読む）
    match /systemStatus/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 管理者の操作の記録（追加と閲覧のみ。変更・削除はできない）
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // 全施設へのお知らせ（管理者が作成し、ログイン中の施設が読む）
    match /systemAnnouncements/{announcementId} {
      allow read: if signedIn() && request.auth.token.role in ['facility', 'admin'];
      allow write: if isAdmin();
    }

    // LPのお問い合わせフォームの新着（サーバーが作成し、管理者が読む・確認済みにするだけ）
    match /adminInbox/{itemId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedAt']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}